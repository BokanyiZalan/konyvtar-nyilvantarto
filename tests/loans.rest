@host=http://localhost

@port=3000

@server={{host}}:{{port}}

###get all loans
GET {{server}}/api/loans

####get loan by id
GET {{server}}/api/loans/2

###add new loan

POST {{server}}/api/loans
Content-Type: application/json

{
    "book_id": 2,
  "reader_id": 3,
  "available": 1,
  "loan_date": "2023-01-01",
  "return_date": "2026-11-15",
  "due_date": "2026-12-15"
}

###modify loan by id
PUT {{server}}/api/loans/3
Content-Type: application/json

{
    "book_id": 2,
  "reader_id": 1,
 
  "loan_date": "2023-01-01",
  "due_date": "2023-01-15",
  "return_date": "2023-01-20"
 
}

###delete loan by id
DELETE {{server}}/api/loans/3

###return loan edit
PATCH {{server}}/api/loans/4/return
Content-Type: application/json

{
  "return_date": "2023-01-20",
  "available": 1
}
